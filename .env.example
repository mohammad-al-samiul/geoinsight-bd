# =============================================================================
# GeoInsight BD — Infrastructure Environment Template
# Copy to `.env` and adjust values before running `docker compose up -d`
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=geoinsight-bd
TZ=Asia/Dhaka

# -----------------------------------------------------------------------------
# PostgreSQL (TimescaleDB) + PgBouncer + Read Replica
# -----------------------------------------------------------------------------
POSTGRES_USER=geoinsight_admin
POSTGRES_PASSWORD=change_me_strong_postgres_password
POSTGRES_DB=geoinsight_db
POSTGRES_PORT=55432
# Windows Hyper-V often reserves 5358-5457 (includes 5432). Use 55432 locally.
POSTGRES_REPLICATION_PASSWORD=change_me_replication_password
PGBOUNCER_PORT=6432

# Pooled write URL (transaction mode via PgBouncer)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:6432/geoinsight_write?schema=public&pgbouncer=true&connection_limit=10
# Analytical reads — replica pool (local dev: same as write until replica is up)
DATABASE_READ_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:6432/geoinsight_read?schema=public&pgbouncer=true&connection_limit=20
# Direct primary — Prisma migrations only
DIRECT_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?schema=public

# -----------------------------------------------------------------------------
# Redis 7 — cache, rate limits, sessions, Socket.io adapter
# -----------------------------------------------------------------------------
REDIS_PASSWORD=change_me_redis_password
REDIS_PORT=6379
# Redis runs inside Docker network only (no host port). Host bind is optional for local CLI tools.
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0
REDIS_MAX_CONNECTIONS=32
ARBITRAGE_CACHE_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=geoinsight_mq
RABBITMQ_DEFAULT_PASS=change_me_strong_rabbitmq_password
RABBITMQ_PORT=5672
# Windows/Hyper-V may reserve 5672-5679; if bind fails, try e.g. RABBITMQ_PORT=35672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_EXCHANGE=geoinsight_exchange
RABBITMQ_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@rabbitmq:5672/

# Queue names (consumed by microservices)
RABBITMQ_GOV_QUEUE=gov_core_queue
RABBITMQ_AI_QUEUE=ai_analytics_queue

# -----------------------------------------------------------------------------
# MinIO Object Storage
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=geoinsight_minio
MINIO_ROOT_PASSWORD=change_me_strong_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_DOCS=national-intelligence-docs
MINIO_ENDPOINT=http://minio:9000
MINIO_USE_SSL=false

# -----------------------------------------------------------------------------
# API Gateway (Node.js) — used when app services are added to compose
# -----------------------------------------------------------------------------
NODE_ENV=development
API_GATEWAY_PORT=4000
JWT_SECRET=change_me_jwt_secret_min_32_chars_long
JWT_EXPIRES_IN=8h
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
PUBLIC_FEED_333_RATE_MAX=30
PUBLIC_FEED_333_WINDOW_MS=60000
PUBLIC_FEED_999_RATE_MAX=15
PUBLIC_FEED_999_WINDOW_MS=60000
AI_SERVICE_URL=http://localhost:8000
SOVEREIGN_MODE=false

# Tier-4 sovereignty (production: see deploy/security/tier4-sovereignty.env.example)
NEXT_TELEMETRY_DISABLED=1
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
DISABLE_TELEMETRY=1

# -----------------------------------------------------------------------------
# AI Analytics (Python FastAPI)
# -----------------------------------------------------------------------------
AI_CORE_PORT=8000
AI_MODEL_CACHE_DIR=./services/ai-analytics-python/ml_models/cache
AI_WORKER_POOL_SIZE=4
AI_SCRAPE_INTERVAL_SEC=300
AI_MOCK_COUNTRY_COUNT=195
BANGLA_BERT_MODEL_ID=l3cube-pune/bengali-sentiment-analysis
SENTIMENT_USE_MOCK=true
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# Local Ollama — all generative AI (briefing, sovereign LLM, citizen chat, documents)
# Host dev: http://localhost:11434 | Docker on Windows: http://host.docker.internal:11434
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
SOVEREIGN_MODE=true

# -----------------------------------------------------------------------------
# Hyperledger Fabric (Project Tracker Chaincode)
# -----------------------------------------------------------------------------
FABRIC_ENABLED=false
FABRIC_CONNECTION_PROFILE_PATH=../../deploy/hyperledger/connection-profile.example.json
FABRIC_WALLET_PATH=./deploy/hyperledger/wallet
FABRIC_IDENTITY_LABEL=geoinsightApp
FABRIC_CHANNEL_NAME=geoinsight-channel
FABRIC_CHAINCODE_NAME=project-tracker
FABRIC_DISCOVERY_AS_LOCALHOST=true
FABRIC_MAX_RETRIES=5
FABRIC_RETRY_INTERVAL_MS=30000

# -----------------------------------------------------------------------------
# Application ports (Docker host → container)
# -----------------------------------------------------------------------------
DASHBOARD_PORT=3000
AI_ANALYTICS_PORT=8000

# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
API_GATEWAY_URL=http://localhost:4000
