# =============================================================================
# GeoInsight BD — Local environment (Windows)
# =============================================================================

COMPOSE_PROJECT_NAME=geoinsight-bd
TZ=Asia/Dhaka

# -----------------------------------------------------------------------------
# PostgreSQL (TimescaleDB) + PgBouncer + Read Replica
# Windows Hyper-V reserves 5358-5457 — use 55432 instead of 5432
# -----------------------------------------------------------------------------
POSTGRES_USER=geoinsight_admin
POSTGRES_PASSWORD=change_me_strong_postgres_password
POSTGRES_DB=geoinsight_db
POSTGRES_PORT=55432
POSTGRES_REPLICATION_PASSWORD=change_me_replication_password
PGBOUNCER_PORT=6432

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:6432/geoinsight_write?schema=public&pgbouncer=true&connection_limit=10
DATABASE_READ_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:6432/geoinsight_read?schema=public&pgbouncer=true&connection_limit=20
DIRECT_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:55432/${POSTGRES_DB}?schema=public

# -----------------------------------------------------------------------------
# Redis 7 — internal Docker network only (no host port on Windows)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=change_me_redis_password
REDIS_PORT=6379
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_MAX_CONNECTIONS=32
ARBITRAGE_CACHE_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=geoinsight_mq
RABBITMQ_DEFAULT_PASS=change_me_strong_rabbitmq_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_EXCHANGE=geoinsight_exchange
RABBITMQ_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@rabbitmq:5672/
RABBITMQ_GOV_QUEUE=gov_core_queue
RABBITMQ_AI_QUEUE=ai_analytics_queue

# -----------------------------------------------------------------------------
# MinIO Object Storage
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=geoinsight_minio
MINIO_ROOT_PASSWORD=change_me_strong_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_DOCS=national-intelligence-docs
MINIO_ENDPOINT=http://minio:9000
MINIO_USE_SSL=false

# -----------------------------------------------------------------------------
# API Gateway (Node.js)
# Host port 4800 — Windows Hyper-V blocks 4000 (range 3940-4039)
# -----------------------------------------------------------------------------
NODE_ENV=development
JWT_SECRET=change_me_jwt_secret_min_32_chars_long
JWT_EXPIRES_IN=8h
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
PUBLIC_FEED_333_RATE_MAX=30
PUBLIC_FEED_333_WINDOW_MS=60000
PUBLIC_FEED_999_RATE_MAX=15
PUBLIC_FEED_999_WINDOW_MS=60000
AI_SERVICE_URL=http://localhost:8000
INGESTION_ENABLED=true
INGESTION_INTERVAL_MS=900000
INGESTION_RUN_ON_START=true
INGESTION_STARTUP_DELAY_MS=45000
PIPELINE_ENABLED=true
PIPELINE_RUN_ON_START=true
PIPELINE_STARTUP_DELAY_MS=60000
PIPELINE_NEWS_INTERVAL_MS=900000
PIPELINE_COMMODITY_INTERVAL_MS=1800000
PIPELINE_KPI_INTERVAL_MS=1800000
PIPELINE_ALERT_INTERVAL_MS=1200000
PIPELINE_AGRO_INTERVAL_MS=1800000
PIPELINE_HAZARD_INTERVAL_MS=1800000
LIVE_DATA_ONLY=true
SOVEREIGN_MODE=true

NEXT_TELEMETRY_DISABLED=1
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
DISABLE_TELEMETRY=1

# -----------------------------------------------------------------------------
# AI Analytics (Python FastAPI) — Ollama for generative decisions
# Docker uses host.docker.internal (set in docker-compose.apps.yml)
# -----------------------------------------------------------------------------
AI_CORE_PORT=8000
AI_MODEL_CACHE_DIR=./services/ai-analytics-python/ml_models/cache
AI_WORKER_POOL_SIZE=4
AI_SCRAPE_INTERVAL_SEC=300
AI_MOCK_COUNTRY_COUNT=195
BANGLA_BERT_MODEL_ID=l3cube-pune/bengali-sentiment-analysis
SENTIMENT_USE_MOCK=false
CORS_ORIGINS=http://localhost:3000,http://localhost:4800

LLM_PROVIDER=ollama
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# -----------------------------------------------------------------------------
# Hyperledger Fabric
# -----------------------------------------------------------------------------
FABRIC_ENABLED=false
FABRIC_CONNECTION_PROFILE_PATH=../../deploy/hyperledger/connection-profile.example.json
FABRIC_WALLET_PATH=./deploy/hyperledger/wallet
FABRIC_IDENTITY_LABEL=geoinsightApp
FABRIC_CHANNEL_NAME=geoinsight-channel
FABRIC_CHAINCODE_NAME=project-tracker
FABRIC_DISCOVERY_AS_LOCALHOST=true
FABRIC_MAX_RETRIES=5
FABRIC_RETRY_INTERVAL_MS=30000

# -----------------------------------------------------------------------------
# Application ports
# -----------------------------------------------------------------------------
DASHBOARD_PORT=3000
API_GATEWAY_PORT=4800
NEXT_PUBLIC_API_URL=http://localhost:4800/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4800
API_GATEWAY_URL=http://localhost:4800
