# GeoInsight BD — Observability environment (copy to .env on VPS)

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong-password
GRAFANA_PORT=3002
GRAFANA_ROOT_URL=https://grafana.geoinsight.gov.bd

# Prometheus / Alertmanager
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093

# Alertmanager SMTP (national gov mail relay)
ALERTMANAGER_SMTP_HOST=smtp.example.gov.bd:587
ALERTMANAGER_SMTP_FROM=sre-alerts@geoinsight.gov.bd
ALERTMANAGER_SMTP_USER=
ALERTMANAGER_SMTP_PASSWORD=
ALERTMANAGER_EMAIL_TO=sre@geoinsight.gov.bd
ALERTMANAGER_CRITICAL_EMAIL=oncall@geoinsight.gov.bd
ALERTMANAGER_LEDGER_EMAIL=ledger-ops@geoinsight.gov.bd
ALERTMANAGER_ML_EMAIL=ml-ops@geoinsight.gov.bd
SLACK_WEBHOOK_URL=
