AI_WORKER_POOL_SIZE=1
AI_SCRAPE_INTERVAL_SEC=300
AI_MOCK_COUNTRY_COUNT=195
BANGLA_BERT_MODEL_ID=l3cube-pune/bengali-sentiment-analysis
# VPS 4–8GB: true — real Bangla-BERT often OOMs / thrashing
SENTIMENT_USE_MOCK=true

# LLM — production best practice: remote Ollama on a separate AI server (≥16GB)
# Local/dev (same machine as Docker): http://host.docker.internal:11434
# Production (app VPS → AI box):      http://AI_SERVER_IP:11434
# Setup: docs/OLLAMA_PRODUCTION.md | bash deploy/scripts/ollama-server-setup.sh
LLM_PROVIDER=ollama
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# Current elected government — politics / economy / unrest news scoped from this date
CURRENT_GOVERNMENT_SINCE=2026-02-15
CURRENT_GOVERNMENT_PARTY=BNP

FABRIC_ENABLED=false
