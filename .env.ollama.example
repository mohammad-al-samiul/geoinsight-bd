# GeoInsight BD — Ollama AI server environment
# Copy: cp .env.ollama.example .env.ollama

OLLAMA_PORT=11434
OLLAMA_KEEP_ALIVE=30m
# One request at a time keeps latency predictable on 16–24GB boxes
OLLAMA_NUM_PARALLEL=1
# Dual-tier: quality (gpt-oss:20b) + fast (llama3.1:8b). Use 2 if RAM ≥24GB;
# on ~16GB keep 1 and accept unload between tiers.
OLLAMA_MAX_LOADED_MODELS=2

# Models to pull after first start (quality + fast)
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_MODEL_FAST=llama3.1:8b
