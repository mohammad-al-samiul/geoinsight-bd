AI_CORE_PORT=8000
REDIS_URL=redis://:change_me_redis_password@localhost:6379/1
REDIS_MAX_CONNECTIONS=32
ARBITRAGE_CACHE_TTL_SECONDS=3600
AI_MODEL_CACHE_DIR=./ml_models/cache
AI_WORKER_POOL_SIZE=4
AI_SCRAPE_INTERVAL_SEC=300
AI_MOCK_COUNTRY_COUNT=195

RABBITMQ_URL=amqp://geoinsight_mq:change_me_strong_rabbitmq_password@localhost:5672/
RABBITMQ_EXCHANGE=geoinsight_exchange
RABBITMQ_AI_QUEUE=ai_analytics_queue

BANGLA_BERT_MODEL_ID=l3cube-pune/bengali-sentiment-analysis
SENTIMENT_USE_MOCK=true

# News ingestion worker interval (used by gateway; AI fetch endpoint)
INGESTION_ENABLED=true
AI_INGESTION_INTERVAL_SEC=900

CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# Ollama LLM
# Local: http://localhost:11434
# Docker on same host: http://host.docker.internal:11434
# Production remote AI server: http://AI_SERVER_IP:11434  (docs/OLLAMA_PRODUCTION.md)
# Quality = briefs; Fast = triage/chat. Classification stays on BanglaBERT.
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_MODEL_FAST=llama3.1:8b
SOVEREIGN_MODE=true
