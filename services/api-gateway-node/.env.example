# Copy to .env for local development (outside Docker)
NODE_ENV=development
API_GATEWAY_PORT=4000

# PgBouncer pools (start docker compose first)
DATABASE_URL=postgresql://geoinsight_admin:change_me_strong_postgres_password@localhost:6432/geoinsight_write?schema=public&pgbouncer=true&connection_limit=10
DATABASE_READ_URL=postgresql://geoinsight_admin:change_me_strong_postgres_password@localhost:6432/geoinsight_read?schema=public&pgbouncer=true&connection_limit=20
DIRECT_DATABASE_URL=postgresql://geoinsight_admin:change_me_strong_postgres_password@localhost:5432/geoinsight_db?schema=public

REDIS_URL=redis://:change_me_redis_password@localhost:6379/0

JWT_SECRET=change_me_jwt_secret_min_32_chars_long
JWT_EXPIRES_IN=8h

RABBITMQ_URL=amqp://geoinsight_mq:change_me_strong_rabbitmq_password@localhost:35672/
RABBITMQ_EXCHANGE=geoinsight_exchange
RABBITMQ_GOV_QUEUE=gov_core_queue

CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
