  @@index([action, createdAt(sort: Desc)])
  @@map("narrative_audit_logs")
}

// ── Local Entity DSS — Instant Action (24hr SLA) + Ward Performance Index ─────

/// Citizen / field complaint with before/after photo SLA (entity-scoped)
model CitizenComplaint {
  id             String            @id @default(uuid()) @db.Uuid
  title          String            @db.VarChar(255)
  titleBn        String?           @map("title_bn") @db.VarChar(255)
  description    String?           @db.Text
  category       ComplaintCategory @default(OTHER)
  severity       ComplaintSeverity @default(MEDIUM)
  status         ComplaintStatus   @default(OPEN)
  citizenName    String?           @map("citizen_name") @db.VarChar(120)
  citizenPhone   String?           @map("citizen_phone") @db.VarChar(20)
  lat            Float?
  lng            Float?
  locationLabel  String?           @map("location_label") @db.VarChar(255)
  /// HTTPS or data-URL for before photo (P1; MinIO keys later)
  beforePhotoUrl String?           @map("before_photo_url") @db.Text
  afterPhotoUrl  String?           @map("after_photo_url") @db.Text
  /// Wave B photo QA: PASS | WARN | FAIL
  photoQaStatus  String?           @map("photo_qa_status") @db.VarChar(24)
  photoQaScore   Float?            @map("photo_qa_score")
  photoQaNote    String?           @map("photo_qa_note") @db.Text
  resolutionNote String?           @map("resolution_note") @db.Text
  /// createdAt + 24h — breach marks operational OVERDUE in API
  slaDeadline    DateTime          @map("sla_deadline") @db.Timestamptz
  isRedAlert     Boolean           @default(false) @map("is_red_alert")
  resolvedAt     DateTime?         @map("resolved_at") @db.Timestamptz

  wardId   String    @map("ward_id") @db.Uuid
  ward     AdminUnit @relation("ComplaintWard", fields: [wardId], references: [id], onDelete: Restrict)
  entityId String    @map("entity_id") @db.Uuid
  entity   AdminUnit @relation("ComplaintEntity", fields: [entityId], references: [id], onDelete: Restrict)

  assigneeId String? @map("assignee_id") @db.Uuid
  assignee   User?   @relation("ComplaintAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  resolvedById String? @map("resolved_by_id") @db.Uuid
  resolvedBy   User?   @relation("ComplaintResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  events ComplaintStatusEvent[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([entityId, status, createdAt(sort: Desc)])
  @@index([wardId, status])
  @@index([isRedAlert, status, slaDeadline])
  @@index([severity, status])
  @@index([assigneeId, status])
  @@map("citizen_complaints")
}

/// Append-only complaint workflow timeline (assign / start / note / resolve)
model ComplaintStatusEvent {
  id          String             @id @default(uuid()) @db.Uuid
  kind        ComplaintEventKind @default(NOTE)
  fromStatus  ComplaintStatus?   @map("from_status")
  toStatus    ComplaintStatus?   @map("to_status")
  note        String?            @db.VarChar(512)

  complaintId String           @map("complaint_id") @db.Uuid
  complaint   CitizenComplaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  actorUserId String? @map("actor_user_id") @db.Uuid
  actor       User?   @relation("ComplaintEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([complaintId, createdAt(sort: Desc)])
  @@index([kind, createdAt(sort: Desc)])
  @@map("complaint_status_events")
}

/// Ward Performance Index (1–100) per entity ward / area
model WardPerformanceScore {
  id               String   @id @default(uuid()) @db.Uuid
  periodKey        String   @map("period_key") @db.VarChar(16)
  /// Overall WPI 1–100
  score            Int
  serviceScore     Int      @map("service_score")
  infraScore       Int      @map("infra_score")
  resolutionScore  Int      @map("resolution_score")
  openComplaints   Int      @default(0) @map("open_complaints")
