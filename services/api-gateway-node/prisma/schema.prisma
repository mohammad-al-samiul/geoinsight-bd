  ward     AdminUnit @relation("WpiWard", fields: [wardId], references: [id], onDelete: Cascade)
  entityId String    @map("entity_id") @db.Uuid
  entity   AdminUnit @relation("WpiEntity", fields: [entityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([wardId, periodKey])
  @@index([entityId, periodKey, score(sort: Desc)])
  @@index([score])
  @@map("ward_performance_scores")
}

