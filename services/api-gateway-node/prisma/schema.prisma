// =============================================================================
// GeoInsight BD — Production Prisma Schema
// PostgreSQL 16 + TimescaleDB | Hierarchical Admin | Multi-tenant RBAC | KPIs
// =============================================================================
//
// TimescaleDB hypertables (commodity_price_logs) are created via raw SQL migration:
//   prisma/migrations/20250627150000_timescale_commodity_perf/migration.sql
//
// Hierarchy: DIVISION → DISTRICT → UPAZILA → UNION (national)
// Local DSS layer: DISTRICT → CONSTITUENCY | CITY_CORPORATION → WARD
// Denormalized location IDs (division_id, district_id, upazila_id) enable
// sub-millisecond scoped queries without recursive CTEs.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum AdminUnitType {
  DIVISION
  DISTRICT
  UPAZILA
  UNION
  /// Parliamentary constituency (e.g. Chattogram-8)
  CONSTITUENCY
  /// City corporation (e.g. CCC, COCC)
  CITY_CORPORATION
  /// Ward under city corp, or thana/area under constituency
  WARD
}

/// Platform access roles (multi-tenant RBAC — scoped via admin_unit_id)
enum UserRole {
  PMO
  MINISTER
  DC
  UNION_CHAIRMAN
  /// Local DSS — scoped to CONSTITUENCY
  MP
  /// Local DSS — scoped to CITY_CORPORATION
  MAYOR
}

enum RepresentativeRole {
  MP
  MINISTER
  DC
  UNION_CHAIRMAN
  UPAZILA_CHAIRMAN
  MAYOR
}

enum KpiAppliesTo {
  REPRESENTATIVE
  ADMIN_UNIT
  PROJECT
  NATIONAL
}

enum KpiRecordStatus {
  DRAFT
  SUBMITTED
  VERIFIED
  REJECTED
}

enum ProjectStatus {
  PLANNED
  ONGOING
  COMPLETED
  STALLED
  CANCELLED
}

enum RedFlagType {
  BUDGET_OVERRUN
  DELAY
  CORRUPTION_RISK
  QUALITY
  CONTRACTOR_FRAUD
  OTHER
}

enum AgroMarketType {
  WHOLESALE
  RETAIL
  HAAT
  MANDI
}

enum BlockchainTxStatus {
  PENDING
  SUBMITTED
  FAILED
  DEAD_LETTER
}

enum RbacAction {
  CREATE
  READ
  UPDATE
  DELETE
  APPROVE
}

enum ExternalArticleSource {
  RSS_NEWSPAPER
  GOOGLE_NEWS
}

enum IngestionSentiment {
  Grievance
  Demand
  Neutral
}

enum LiveSignalType {
  PROJECT
  REPRESENTATIVE
  ALERT
  POLICY
}

enum ComplaintSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum ComplaintCategory {
  INFRASTRUCTURE
  DRAINAGE
  WASTE
  SAFETY
  TRAFFIC
  HILL_CUTTING
  HERITAGE
  OTHER
}

enum ComplaintEventKind {
  CREATED
  ASSIGNED
  STARTED
  NOTE
  RESOLVED
}

// ── Hierarchical Administrative Structure (Bangladesh) ───────────────────────

model AdminUnit {
  id       String        @id @default(uuid()) @db.Uuid
  /// BBS / GeoINSIGHT canonical code (e.g. "30" = Dhaka Division)
  code     String        @db.VarChar(16)
  name     String        @db.VarChar(255)
  nameBn   String?       @map("name_bn") @db.VarChar(255)
  type     AdminUnitType
  parentId String?       @map("parent_id") @db.Uuid
  /// Materialized path for hierarchy walks (e.g. /division_id/district_id/...)
  path     String?       @db.VarChar(512)
  geoJson  Json?         @map("geo_json")

  // Denormalized ancestor IDs — populated by trigger for O(1) location filters
  divisionId String? @map("division_id") @db.Uuid
  districtId String? @map("district_id") @db.Uuid
  upazilaId  String? @map("upazila_id") @db.Uuid

  parent   AdminUnit?  @relation("AdminHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children AdminUnit[] @relation("AdminHierarchy")

  representatives Representative[]
  users           User[]
  projects        Project[]
  agroMarkets     AgroMarket[]
  commodityLogs   CommodityPriceLog[]

  complaintsAsWard   CitizenComplaint[]      @relation("ComplaintWard")
  complaintsAsEntity CitizenComplaint[]      @relation("ComplaintEntity")
  wardScoresAsWard   WardPerformanceScore[]  @relation("WpiWard")
  wardScoresAsEntity WardPerformanceScore[]  @relation("WpiEntity")
  influencersAsWard  LocalInfluencer[]       @relation("InfluencerWard")
  influencersAsEntity LocalInfluencer[]      @relation("InfluencerEntity")
  pollingAsWard      LocalPollingCenter[]    @relation("PollingWard")
  pollingAsEntity    LocalPollingCenter[]    @relation("PollingEntity")
  osintAsWard        LocalOsintHit[]         @relation("OsintWard")
  osintAsEntity      LocalOsintHit[]         @relation("OsintEntity")
  specialtyAsWard    LocalSpecialtySignal[]  @relation("SpecialtyWard")
  specialtyAsEntity  LocalSpecialtySignal[]  @relation("SpecialtyEntity")
  outagesAsWard      LocalServiceOutage[]    @relation("OutageWard")
  outagesAsEntity    LocalServiceOutage[]    @relation("OutageEntity")
  visitsAsWard       LocalVisitPlan[]        @relation("VisitWard")
  visitsAsEntity     LocalVisitPlan[]        @relation("VisitEntity")
  pulseEventsAsWard  LocalPulseEvent[]       @relation("PulseEventWard")
  pulseEventsAsEntity LocalPulseEvent[]      @relation("PulseEventEntity")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([type, code])
  @@index([parentId, type])
  @@index([type, code])
  @@index([divisionId, districtId, upazilaId])
  @@index([divisionId])
  @@index([districtId])
  @@index([upazilaId])
  @@map("admin_units")
}

// ── Multi-tenant RBAC ─────────────────────────────────────────────────────────

/// Static role → permission matrix (national roles use admin_unit_id = NULL)
model RolePermission {
  id           String         @id @default(uuid()) @db.Uuid
  role         UserRole
  resource     String         @db.VarChar(64)
  action       RbacAction
  /// Minimum admin level required when permission is unit-scoped
  minUnitType  AdminUnitType? @map("min_unit_type")
  description  String?        @db.VarChar(255)

  @@unique([role, resource, action])
  @@index([role, resource])
  @@map("role_permissions")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(255)
  phone        String?  @db.VarChar(20)
  passwordHash String   @map("password_hash")
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  mfaSecret    String?  @map("mfa_secret")

  /// Tenant scope — NULL only for PMO (national)
  adminUnitId String?    @map("admin_unit_id") @db.Uuid
  adminUnit   AdminUnit? @relation(fields: [adminUnitId], references: [id], onDelete: SetNull)

  auditLogs             AuditLog[]
  resolvedRedFlags      RedFlagAlert[]    @relation("ResolvedBy")
  resolvedComplaints    CitizenComplaint[] @relation("ComplaintResolvedBy")
  assignedComplaints    CitizenComplaint[] @relation("ComplaintAssignee")
  complaintEvents       ComplaintStatusEvent[] @relation("ComplaintEventActor")
  refreshTokens         RefreshToken[]
  alertDeliveries       AlertDeliveryLog[]
  visitPlansCreated     LocalVisitPlan[]       @relation("VisitCreatedBy")
  pulseEventsCreated    LocalPulseEvent[]      @relation("PulseEventCreatedBy")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([adminUnitId, role, isActive])
  @@index([role, isActive])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ── Representatives ───────────────────────────────────────────────────────────

model Representative {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @db.VarChar(255)
  nid         String             @unique @db.VarChar(20)
  role        RepresentativeRole
  party       String?            @db.VarChar(120)
  tenureStart DateTime           @map("tenure_start") @db.Date
  tenureEnd   DateTime?          @map("tenure_end") @db.Date

  adminUnitId String    @map("admin_unit_id") @db.Uuid
  adminUnit   AdminUnit @relation(fields: [adminUnitId], references: [id], onDelete: Restrict)

  kpiRecords    KpiRecord[]
  commodityLogs CommodityPriceLog[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([adminUnitId, role])
  @@index([adminUnitId, tenureEnd])
  @@index([role, tenureEnd])
  @@map("representatives")
}

// ── Representative KPIs ───────────────────────────────────────────────────────

model KpiDefinition {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique @db.VarChar(50)
  name      String       @db.VarChar(255)
  nameBn    String?      @map("name_bn") @db.VarChar(255)
  unit      String       @db.VarChar(32)
  appliesTo KpiAppliesTo @map("applies_to")

  records KpiRecord[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("kpi_definitions")
}

model KpiRecord {
  id             String          @id @default(uuid()) @db.Uuid
  value          Decimal         @db.Decimal(18, 4)
  recordedAt     DateTime        @map("recorded_at") @db.Timestamptz
  fiscalYear     String          @map("fiscal_year") @db.Char(4)
  status         KpiRecordStatus @default(SUBMITTED)
  verified       Boolean         @default(false)
  blockchainHash String?         @map("blockchain_hash") @db.VarChar(128)

  representativeId String         @map("representative_id") @db.Uuid
  representative   Representative @relation(fields: [representativeId], references: [id], onDelete: Cascade)

  kpiDefId String        @map("kpi_def_id") @db.Uuid
  kpiDef   KpiDefinition @relation(fields: [kpiDefId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([representativeId, status, recordedAt(sort: Desc)])
  @@index([representativeId, kpiDefId, fiscalYear])
  @@index([kpiDefId, fiscalYear, status])
  @@index([recordedAt(sort: Desc)])
  @@map("kpi_records")
}

// ── Global Trade & Agri-Economic Time-Series ───────────────────────────────────
// NOTE: TimescaleDB hypertable conversion applied in SQL migration (created_at).

model CommodityPriceLog {
  id              String   @default(uuid()) @db.Uuid
  commodityCode   String   @map("commodity_code") @db.VarChar(50)
  countryCode     String   @map("country_code") @db.Char(3)
  countryName     String   @map("country_name") @db.VarChar(120)
  unitPriceUsd    Decimal  @map("unit_price_usd") @db.Decimal(18, 4)
  shippingCostUsd Decimal? @map("shipping_cost_usd") @db.Decimal(18, 2)
  tariffRate      Decimal? @map("tariff_rate") @db.Decimal(8, 4)
  landedCostUsd   Decimal? @map("landed_cost_usd") @db.Decimal(18, 2)
  sourceRank      Int?     @map("source_rank")
  metadata        Json?

  /// BD administrative context (optional — for domestic arbitrage overlays)
  adminUnitId String?    @map("admin_unit_id") @db.Uuid
  adminUnit   AdminUnit? @relation(fields: [adminUnitId], references: [id], onDelete: SetNull)

  divisionId String? @map("division_id") @db.Uuid
  districtId String? @map("district_id") @db.Uuid
  upazilaId  String? @map("upazila_id") @db.Uuid

  representativeId String?         @map("representative_id") @db.Uuid
  representative   Representative? @relation(fields: [representativeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([id, createdAt])
  @@index([commodityCode, countryCode, createdAt(sort: Desc)])
  @@index([representativeId, createdAt(sort: Desc)])
  @@index([divisionId, districtId, createdAt(sort: Desc)])
  @@index([districtId, upazilaId, createdAt(sort: Desc)])
  @@index([adminUnitId, createdAt(sort: Desc)])
  @@map("commodity_price_logs")
}

// ── Projects & Alerts ─────────────────────────────────────────────────────────

model Project {
  id              String        @id @default(uuid()) @db.Uuid
  title           String
  budgetAllocated Decimal       @map("budget_allocated") @db.Decimal(18, 2)
  budgetSpent     Decimal       @default(0) @map("budget_spent") @db.Decimal(18, 2)
  status          ProjectStatus
  contractorNid   String?       @map("contractor_nid") @db.VarChar(20)
  startDate       DateTime      @map("start_date") @db.Date
  blockchainTx    String?       @map("blockchain_tx") @db.VarChar(128)

  adminUnitId String    @map("admin_unit_id") @db.Uuid
  adminUnit   AdminUnit @relation(fields: [adminUnitId], references: [id], onDelete: Restrict)

  redFlagAlerts  RedFlagAlert[]
  milestoneQueue BlockchainMilestoneQueue[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([adminUnitId, status])
  @@index([status, adminUnitId])
  @@index([status, startDate(sort: Desc)])
  @@map("projects")
}

model RedFlagAlert {
  id            String       @id @default(uuid()) @db.Uuid
  flagType      RedFlagType  @map("flag_type")
  severity      Int
  aiExplanation String?      @map("ai_explanation")
  resolvedAt    DateTime?    @map("resolved_at") @db.Timestamptz
  blockchainHash     String?  @map("blockchain_hash") @db.VarChar(128)
  blockchainVerified Boolean  @default(false) @map("blockchain_verified")

  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  resolvedById String? @map("resolved_by") @db.Uuid
  resolvedBy   User?   @relation("ResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([projectId, resolvedAt])
  @@index([severity, resolvedAt])
  @@map("red_flag_alerts")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  action    String   @db.VarChar(100)
  tableName String   @map("table_name") @db.VarChar(100)
  recordId  String   @map("record_id") @db.Uuid
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([tableName, recordId])
  @@map("audit_logs")
}

model AgroMarket {
  id   String         @id @default(uuid()) @db.Uuid
  name String         @db.VarChar(255)
  lat  Float
  lng  Float
  type AgroMarketType

  /// Live price from commodity pipeline (BDT per kg)
  commodityCode  String?   @map("commodity_code") @db.VarChar(50)
  priceBdtPerKg  Decimal?  @map("price_bdt_per_kg") @db.Decimal(18, 4)
  priceUpdatedAt DateTime? @map("price_updated_at") @db.Timestamptz

  adminUnitId String    @map("admin_unit_id") @db.Uuid
  adminUnit   AdminUnit @relation(fields: [adminUnitId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([adminUnitId, type])
  @@map("agro_markets")
}

model BlockchainMilestoneQueue {
  id                 String             @id @default(uuid()) @db.Uuid
  projectId          String             @map("project_id") @db.Uuid
  representativeId   String             @map("representative_id") @db.Uuid
  allocatedBudget    Decimal            @map("allocated_budget") @db.Decimal(18, 2)
  spendingVariance   Decimal            @map("spending_variance") @db.Decimal(18, 4)
  progressPercentage Decimal            @map("progress_percentage") @db.Decimal(5, 2)
  payloadHash        String             @unique @map("payload_hash") @db.VarChar(64)
  status             BlockchainTxStatus @default(PENDING)
  retryCount         Int                @default(0) @map("retry_count")
  maxRetries         Int                @default(5) @map("max_retries")
  lastError          String?            @map("last_error")
  fabricTxId         String?            @map("fabric_tx_id") @db.VarChar(128)
  chaincodeName      String             @map("chaincode_name") @db.VarChar(120)
  nextRetryAt        DateTime           @default(now()) @map("next_retry_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status, nextRetryAt])
  @@index([representativeId, status])
  @@index([projectId, status])
  @@map("blockchain_milestone_queue")
}

/// Online news / Google News articles ingested for sentiment intelligence
model ExternalArticle {
  id                String                @id @default(uuid()) @db.Uuid
  sourceType        ExternalArticleSource @map("source_type")
  sourceName        String                @map("source_name") @db.VarChar(128)
  title             String                @db.Text
  summary           String?               @db.Text
  url               String                @unique @db.VarChar(2048)
  publishedAt       DateTime?             @map("published_at") @db.Timestamptz
  district          String?               @db.VarChar(64)
  division          String?               @db.VarChar(64)
  sentimentCategory IngestionSentiment?   @map("sentiment_category")
  sentimentScore    Decimal?              @map("sentiment_score") @db.Decimal(6, 4)
  language          String                @default("bn") @db.VarChar(8)
  fetchedAt         DateTime              @default(now()) @map("fetched_at") @db.Timestamptz

  @@index([fetchedAt(sort: Desc)])
  @@index([district, sentimentCategory])
  @@index([sourceType, publishedAt(sort: Desc)])
  @@map("external_articles")
}

/// Entities extracted from live news — replaces seed/demo data when LIVE_DATA_ONLY=true
model LiveSignal {
  id                String           @id @default(uuid()) @db.Uuid
  signalType        LiveSignalType   @map("signal_type")
  title             String           @db.Text
  body              String?          @db.Text
  url               String           @unique @db.VarChar(2048)
  sourceName        String           @map("source_name") @db.VarChar(128)
  district          String?          @db.VarChar(64)
  division          String?          @db.VarChar(64)
  adminUnitId       String?          @map("admin_unit_id") @db.Uuid
  severity          Int?
  flagType          String?          @map("flag_type") @db.VarChar(32)
  sentimentCategory IngestionSentiment? @map("sentiment_category")
  articleId         String?          @map("article_id") @db.Uuid
  publishedAt       DateTime?        @map("published_at") @db.Timestamptz
  resolvedAt        DateTime?        @map("resolved_at") @db.Timestamptz
  resolvedById      String?          @map("resolved_by") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@index([signalType, createdAt(sort: Desc)])
  @@index([signalType, resolvedAt])
  @@index([district, signalType])
  @@index([adminUnitId])
  @@map("live_signals")
}

/// Live weather observations per division (Open-Meteo pipeline)
model WeatherObservation {
  id              String   @id @default(uuid()) @db.Uuid
  division        String   @db.VarChar(64)
  district        String?  @db.VarChar(64)
  nameBn          String   @map("name_bn") @db.VarChar(64)
  lat             Float
  lng             Float
  tempC           Decimal  @map("temp_c") @db.Decimal(5, 2)
  humidityPct     Int      @map("humidity_pct")
  precipitationMm Decimal  @map("precipitation_mm") @db.Decimal(8, 2)
  windSpeedKmh    Decimal  @map("wind_speed_kmh") @db.Decimal(6, 2)
  weatherCode     Int      @map("weather_code")
  weatherLabel    String   @map("weather_label") @db.VarChar(64)
  weatherLabelBn  String   @map("weather_label_bn") @db.VarChar(64)
  floodRisk       Int      @map("flood_risk")
  cycloneRisk     Int      @map("cyclone_risk")
  heatStress      Int      @map("heat_stress")
  populationAtRisk Int     @map("population_at_risk")
  source          String   @default("open-meteo") @db.VarChar(32)
  recordedAt      DateTime @map("recorded_at") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([division, recordedAt(sort: Desc)])
  @@index([district, recordedAt(sort: Desc)])
  @@index([recordedAt(sort: Desc)])
  @@map("weather_observations")
}

/// Active disaster alerts (GDACS + news pipeline)
model DisasterAlert {
  id               String    @id @default(uuid()) @db.Uuid
  externalId       String    @unique @map("external_id") @db.VarChar(512)
  alertType        String    @map("alert_type") @db.VarChar(32)
  severity         Int
  title            String    @db.Text
  titleBn          String?   @map("title_bn") @db.Text
  description      String?   @db.Text
  division         String?   @db.VarChar(64)
  lat              Float?
  lng              Float?
  populationAtRisk Int?      @map("population_at_risk")
  validFrom        DateTime  @map("valid_from") @db.Timestamptz
  validTo          DateTime? @map("valid_to") @db.Timestamptz
  source           String    @default("gdacs") @db.VarChar(32)
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([alertType, isActive])
  @@index([division, isActive])
  @@map("disaster_alerts")
}

enum IntelSnapshotKind {
  BRIEFING
  OUTLOOK
  UNREST
}

enum NarrativeThreatLevel {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum NarrativeCategory {
  ANTI_GOVT_INCITEMENT
  SOVEREIGNTY_THREAT
  ECONOMIC_DISINFO
  SOCIAL_UNREST
  RELIGIOUS_EXTREMISM
  ELECTORAL_MANIPULATION
}

enum NarrativeSignalStatus {
  ACTIVE
  DEBUNKED
  ESCALATED
  DISMISSED
}

enum NarrativeFactCheckStatus {
  AUTHENTIC
  NEEDS_REVIEW
  LIKELY_DISINFO
  UNVERIFIED
}

/// Persisted AI / pipeline analysis for PM briefing, political & economic outlook, unrest
model IntelAnalysisSnapshot {
  id          String            @id @default(uuid()) @db.Uuid
  kind        IntelSnapshotKind
  lang        String            @default("bn") @db.VarChar(8)
  /// Optional admin scope id (null = national)
  scopeKey    String?           @map("scope_key") @db.VarChar(64)
  payload     Json
  sourceCount Int               @default(0) @map("source_count")
  llmUsed     Boolean           @default(false) @map("llm_used")
  generatedAt DateTime          @default(now()) @map("generated_at") @db.Timestamptz

  @@index([kind, lang, generatedAt(sort: Desc)])
  @@index([kind, scopeKey, generatedAt(sort: Desc)])
  @@map("intel_analysis_snapshots")
}

/// Audit log — each pipeline cron/manual job (news, briefing, outlook, …)
model PipelineJobRun {
  id          String   @id @default(uuid()) @db.Uuid
  job         String   @db.VarChar(32)
  ok          Boolean
  detail      Json?
  durationMs  Int?     @map("duration_ms")
  startedAt   DateTime @default(now()) @map("started_at") @db.Timestamptz
  completedAt DateTime @default(now()) @map("completed_at") @db.Timestamptz

  @@index([job, completedAt(sort: Desc)])
  @@index([completedAt(sort: Desc)])
  @@map("pipeline_job_runs")
}

